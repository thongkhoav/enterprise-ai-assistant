APP_ENV=local

# JWT authentication. Use a long random string for JWT_SECRET in production.
JWT_SECRET=dev-jwt-secret-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

OPENAI_API_KEY=
OPENAI_MODEL=

# Embedding providers:
# - hash: free deterministic local fallback, good for bootstrapping/tests.
# - local: free local model via fastembed. Run: uv sync --extra dev --extra local-embeddings
# - openai: OpenAI paid embedding API.
# - auto: OpenAI if OPENAI_API_KEY exists, else local if fastembed is installed, else hash.
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

CHROMA_PATH=data/chroma
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/enterprise_ai
TRACE_LOG_PATH=logs/traces.jsonl
# Roles: admins manage documents and answer the support inbox; members only chat.
# Accounts registered with these emails become admins (comma separated).
ADMIN_EMAILS=
# Public demo only: lets any signed-in user switch between member and admin.
DEMO_ROLE_SWITCH=false
# Other ways to reach a person, shown under answers (JSON list). Defaults to Acme examples.
# SUPPORT_CHANNELS=[{"kind":"email","label":"Email the help desk","href":"mailto:help@example.com"}]

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
