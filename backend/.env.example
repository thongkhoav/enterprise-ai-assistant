APP_ENV=local

# JWT authentication. Use a long random string for JWT_SECRET in production.
JWT_SECRET=dev-jwt-secret-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

OPENAI_API_KEY=
OPENAI_MODEL=

# Embedding providers:
# - hash: free deterministic local fallback, good for bootstrapping/tests.
# - local: free local model via fastembed. Run: uv sync --extra dev --extra local-embeddings
# - openai: OpenAI paid embedding API.
# - auto: OpenAI if OPENAI_API_KEY exists, else local if fastembed is installed, else hash.
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

CHROMA_PATH=data/chroma
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/enterprise_ai
TRACE_LOG_PATH=logs/traces.jsonl
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
