VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=dev-secret

# Show "Continue as guest" on the sign-in page (handy for a public link). Set false to hide it.
VITE_GUEST_ACCESS=true
# Other sites allowed to host the widget (comma separated). The app's own origin is always allowed.
VITE_EMBED_ALLOWED_ORIGINS=
